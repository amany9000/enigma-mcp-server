# This manifest is for a Python application (src.gdrive_mcp_server) running as a
# Gramine Shielded Container on Azure SGX.

# --- Performance and Resource Configuration ---
sys.stack.size = "2M"


# --- Application Entry Point Configuration ---
[loader]
env.PORT = { passthrough = true }

[libos]
entrypoint = "/usr/local/bin/python"
check_invalid_pointers = false

# --- Filesystem Configuration ---
[[fs.mounts]]
path = "/app/tmp/"
type = "tmpfs"

[fs.root]
type = "chroot"
uri = "file:/"

# --- SGX Security and Attestation Configuration ---
[sgx]
debug = true
edmm_enable = false
remote_attestation = "dcap"
trusted_files = [
  "file:/usr/local/bin/python",
  "file:/usr/local/bin/python3",
  "file:/usr/local/lib/python3.12/tty.py",
  "file:/usr/local/lib/python3.12/socketserver.py",
